import csv
import os
import statistics


RESULTS_DIR = "results"

CLIENT_FILES = [
    "latency_client1.csv",
    "latency_client2.csv",
    "latency_client3.csv"
]


def read_latencies():

    values = []

    for filename in CLIENT_FILES:

        path = os.path.join(RESULTS_DIR, filename)

        if not os.path.exists(path):
            continue

        with open(path, "r", newline="") as file:

            reader = csv.DictReader(file)

            for row in reader:

                try:
                    latency = float(row["latency_ms"])
                    values.append(latency)

                except (ValueError, KeyError):
                    pass

    return values


def calculate_average():

    values = read_latencies()

    if not values:
        return None

    return statistics.mean(values)


def save_result(experiment, congestion, priority):

    values = read_latencies()

    if values:

        average = statistics.mean(values)
        minimum = min(values)
        maximum = max(values)

    else:

        average = 0
        minimum = 0
        maximum = 0

    path = os.path.join(
        RESULTS_DIR,
        "experiment_results.csv"
    )

    file_exists = os.path.exists(path)

    with open(path, "a", newline="") as file:

        writer = csv.writer(file)

        if not file_exists:

            writer.writerow([
                "experiment",
                "congestion",
                "sdn_priority",
                "packets_measured",
                "average_latency_ms",
                "minimum_latency_ms",
                "maximum_latency_ms"
            ])

        writer.writerow([
            experiment,
            congestion,
            priority,
            len(values),
            f"{average:.3f}",
            f"{minimum:.3f}",
            f"{maximum:.3f}"
        ])

    print()
    print("=" * 60)
    print(f"Experiment: {experiment}")
    print("=" * 60)
    print(f"Congestion       : {congestion}")
    print(f"SDN priority     : {priority}")
    print(f"Packets measured : {len(values)}")
    print(f"Average latency  : {average:.3f} ms")
    print(f"Minimum latency  : {minimum:.3f} ms")
    print(f"Maximum latency  : {maximum:.3f} ms")


def main():

    print("1. Experiment A - No congestion")
    print("2. Experiment B - Congestion without priority")
    print("3. Experiment C - Congestion with SDN priority")

    choice = input("\nSelect experiment: ").strip()

    if choice == "1":

        save_result(
            "A",
            "NO",
            "NO"
        )

    elif choice == "2":

        save_result(
            "B",
            "YES",
            "NO"
        )

    elif choice == "3":

        save_result(
            "C",
            "YES",
            "YES"
        )

    else:

        print("Invalid choice.")


if __name__ == "__main__":
    main()
