from mininet.net import Mininet
from mininet.node import RemoteController, OVSSwitch
from mininet.cli import CLI
from mininet.log import setLogLevel, info
from mininet.link import TCLink
from mininet.topo import Topo


class EmergencyTopology(Topo):

    def build(self):

        # -----------------------------
        # Hosts
        # -----------------------------

        h1 = self.addHost(
            "h1",
            ip="10.0.0.1/24"
        )

        h2 = self.addHost(
            "h2",
            ip="10.0.0.2/24"
        )

        h3 = self.addHost(
            "h3",
            ip="10.0.0.3/24"
        )

        h4 = self.addHost(
            "h4",
            ip="10.0.0.4/24"
        )

        # -----------------------------
        # OVS switches
        # -----------------------------

        s1 = self.addSwitch(
            "s1"
        )

        s2 = self.addSwitch(
            "s2"
        )

        # -----------------------------
        # Links
        # -----------------------------

        # Server → first switch
        self.addLink(
            h1,
            s1
        )

        # Inter-switch link
        # Bottleneck link used for
        # congestion experiments
        self.addLink(
            s1,
            s2,
            cls=TCLink,
            bw=10
        )

        # Clients → second switch
        self.addLink(
            s2,
            h2
        )

        self.addLink(
            s2,
            h3
        )

        self.addLink(
            s2,
            h4
        )


def run():

    topo = EmergencyTopology()

    net = Mininet(
        topo=topo,
        controller=None,
        switch=OVSSwitch,
        link=TCLink,
        autoSetMacs=True
    )

    # Connect switches to Person 2's Ryu controller
    controller = RemoteController(
        "c0",
        ip="127.0.0.1",
        port=6653
    )

    net.addController(controller)

    info("*** Starting network\n")
    net.start()

    info("*** Network started\n")

    info("*** Testing connectivity\n")
    net.pingAll()

    info("*** Starting Mininet CLI\n")

    CLI(net)

    info("*** Stopping network\n")
    net.stop()


if __name__ == "__main__":

    setLogLevel("info")
    run()
