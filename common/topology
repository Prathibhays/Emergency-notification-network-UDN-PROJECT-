from mininet.topo import Topo
from mininet.net import Mininet
from mininet.node import RemoteController, OVSSwitch
from mininet.link import TCLink
from mininet.cli import CLI
from mininet.log import setLogLevel


class EmergencyTopo(Topo):

    def build(self):

        s1 = self.addSwitch('s1')
        s2 = self.addSwitch('s2')

        h1 = self.addHost('h1', ip='10.0.0.1/24')
        h2 = self.addHost('h2', ip='10.0.0.2/24')
        h3 = self.addHost('h3', ip='10.0.0.3/24')
        h4 = self.addHost('h4', ip='10.0.0.4/24')

        # Switch-to-switch link
        self.addLink(
            s1, s2,
            cls=TCLink,
            bw=10,
            delay='5ms'
        )

        # Server link - intentionally limited
        self.addLink(
            h1, s2,
            cls=TCLink,
            bw=2,
            delay='10ms',
            max_queue_size=20
        )

        # Client links
        self.addLink(h2, s2, cls=TCLink, bw=10)
        self.addLink(h3, s2, cls=TCLink, bw=10)
        self.addLink(h4, s2, cls=TCLink, bw=10)


topos = {
    'emergency': EmergencyTopo
}


if __name__ == '__main__':

    setLogLevel('info')

    topo = EmergencyTopo()

    net = Mininet(
        topo=topo,
        switch=OVSSwitch,
        controller=None,
        link=TCLink
    )

    # Change port if your Ryu teammate uses another port
    net.addController(
        'c0',
        controller=RemoteController,
        ip='127.0.0.1',
        port=6653
    )

    net.start()

    print("\n*** Emergency notification topology started ***")
    print("h1 = Server")
    print("h2 = Client 1")
    print("h3 = Client 2")
    print("h4 = Client 3")

    CLI(net)

    net.stop()
