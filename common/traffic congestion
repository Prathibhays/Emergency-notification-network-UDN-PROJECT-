import subprocess
import time


# IP addresses of the three clients
CLIENTS = [
    "10.0.0.2",
    "10.0.0.3",
    "10.0.0.4"
]

# Background UDP traffic per client
BANDWIDTH = "5M"

# How long congestion will run
DURATION = 30


def start_congestion():

    processes = []

    print("======================================")
    print("STARTING UDP BACKGROUND TRAFFIC")
    print("======================================")

    for client in CLIENTS:

        command = [
            "iperf3",
            "-c",
            client,
            "-u",
            "-b",
            BANDWIDTH,
            "-t",
            str(DURATION)
        ]

        print(f"Starting traffic: h1 -> {client}")

        process = subprocess.Popen(command)

        processes.append(process)

    print()
    print("Congestion traffic started.")
    print(f"Bandwidth per client : {BANDWIDTH}")
    print(f"Number of clients    : {len(CLIENTS)}")
    print(f"Total attempted rate : 15 Mbps")
    print(f"Duration             : {DURATION} seconds")
    print()

    return processes


def stop_congestion(processes):

    print("\nStopping congestion...")

    for process in processes:
        process.terminate()

    print("Congestion stopped.")


def main():

    processes = start_congestion()

    try:
        time.sleep(DURATION)

    except KeyboardInterrupt:
        print("\nInterrupted by user.")

    finally:
        stop_congestion(processes)


if __name__ == "__main__":
    main()
